# ---- Database (MySQL) ----
DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/smarthire_ai

# ---- JWT Authentication ----
JWT_SECRET_KEY=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ---- File upload ----
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# ---- CORS (comma separated) ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- First admin account (used by create_admin.py) ----
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@smarthire.ai
ADMIN_PASSWORD=Admin@12345
